# =============================================================================
# pegasus-healer — LLM credentials & configuration
#
# Copy this file to ~/.pegasus/healer.env and fill in your values.
# This file is loaded automatically by pegasus-healer on every run.
#
#   cp healer.env.example ~/.pegasus/healer.env
#   chmod 600 ~/.pegasus/healer.env
#
# Precedence (highest wins):
#   1. Shell environment variables
#   2. .env in current directory (project-level overrides)
#   3. ~/.pegasus/healer.env  ← this file
# =============================================================================

# ── LLM — shared defaults ────────────────────────────────────────────────────
# Model name in litellm format — works with any provider:
#   OpenAI       : gpt-4o, gpt-4o-mini
#   Anthropic    : anthropic/claude-sonnet-4-6, anthropic/claude-haiku-4-5
#   Local/Ollama : ollama/llama3.1, ollama/mistral
#   Azure        : azure/gpt-4o
#   vLLM         : openai/llama3-70b  (with LLM_BASE_URL set)
LLM_MODEL=gpt-4o

# API key for the chosen provider.
# For local endpoints (Ollama, vLLM) this can be left blank or set to "none".
LLM_API_KEY=

# Base URL — only needed for local or institutional endpoints.
# Example: http://llm.your-cluster.edu:8000/v1
# LLM_BASE_URL=

# ── LLM — per-agent overrides (optional) ─────────────────────────────────────
# DiagnosisAgent runs multi-step ReAct — use a strong reasoning model.
# Defaults to the shared LLM_* values if not set.
# DIAGNOSIS_LLM_MODEL=gpt-4o
# DIAGNOSIS_LLM_API_KEY=
# DIAGNOSIS_LLM_BASE_URL=

# FixPlanningAgent is a single structured call — a cheaper model is fine.
# FIX_PLANNING_LLM_MODEL=gpt-4o-mini
# FIX_PLANNING_LLM_API_KEY=
# FIX_PLANNING_LLM_BASE_URL=

# ── Policy ────────────────────────────────────────────────────────────────────
# Healer policy mode: production (conservative) | debug (aggressive, more AUTO)
# HEALER_POLICY_MODE=production

# ── Observability ─────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# OTLP_ENDPOINT=
