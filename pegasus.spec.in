Name:           pegasus
Version:        @PEGASUS_VERSION@
Release:        1%{?dist}
Summary:        Workflow management system for HTCondor, grids, and clouds
Group:          Applications/System
License:        ASL 2.0
URL:            http://pegasus.isi.edu/
Packager:       Pegasus Development Team <pegasus-support@isi.edu>

Source:         pegasus-%{version}.tar.gz

BuildRequires:  gcc, gcc-c++, make, cmake, golang, openssl-devel, systemd-rpm-macros
Requires:       which, graphviz, %{?systemd_requires}

%global debug_package %{nil}

%if 0%{?rhel} == 8
BuildRequires:  java-17-openjdk-devel, python3.12-devel, python3.12-pip
Requires:       java-17-openjdk-headless, python3.12
%define pegasus_python 3.12
%endif

%if 0%{?rhel} == 9
BuildRequires:  java-21-openjdk-devel, python3.12-devel, python3.12-pip
Requires:       java-21-openjdk-headless, python3.12
%define pegasus_python 3.12
%endif

%if 0%{?rhel} == 10
BuildRequires:  java-21-openjdk-devel, python3-devel, python3-pip
Requires:       java-21-openjdk-headless, python3
%define pegasus_python 3.14
%endif

# System interpreter's site-packages dir — used only to drop the pegasus.pth
# that puts the (venv-private) Pegasus package on python%{pegasus_python}'s path.
%global python_sitearch %(/usr/bin/python%{pegasus_python} -c "import sysconfig; print(sysconfig.get_paths(vars={'base': '/usr', 'platbase': '/usr'})['platlib'])")

%define sourcedir %{name}-%{version}

# Self-contained install layout: Pegasus + all runtime deps live in a private
# venv under %{pegasus_home}; nothing is dumped into the system site-packages.
%global pegasus_home %{_prefix}/lib/pegasus
%global pegasus_venv %{pegasus_home}/venv

# Disables the automatic dependency generator (deps are bundled in the venv)
%{?python_disable_dependency_generator}

# Turn off automatic Python bytecompilation
%undefine __brp_python_bytecompile

%description
The Pegasus project encompasses a set of technologies that
help workflow-based applications execute in a number of
different environments including desktops, campus clusters,
grids, and now clouds. Scientific workflows allow users to
easily express multi-step computations. Once an application
is formalized as a workflow the Pegasus Workflow Management
Service can map it onto available compute resources and
execute the steps in appropriate order.


%prep
%setup -q -n %{sourcedir}

%build
# Install build tooling into a temporary virtualenv (not available as distro packages)
/usr/bin/python%{pegasus_python} -m venv _build_venv
_build_venv/bin/pip install --upgrade pip scikit-build-core build
PYTHON=$(pwd)/_build_venv/bin/python make build-worker dist-wheel

%install
# Build a self-contained venv holding Pegasus + all runtime dependencies, the
# CLI entry-point scripts, the C binaries and the JARs. Nothing is installed
# into the system site-packages, so the bundled deps (Flask, sqlalchemy, boto3,
# globus-sdk, ...) cannot conflict with or shadow distro python packages.
/usr/bin/python%{pegasus_python} -m venv %{buildroot}%{pegasus_venv}
%{buildroot}%{pegasus_venv}/bin/pip install --upgrade pip
%{buildroot}%{pegasus_venv}/bin/pip install dist/pegasus_wms-*.whl

# The venv was created under %{buildroot}, so its generated script shebangs and
# pyvenv.cfg embed that build-time prefix. Strip it so the paths are correct once
# installed. (bin/python is a symlink to the system interpreter, already correct.)
grep -rlI '%{buildroot}' %{buildroot}%{pegasus_venv}/bin \
    | xargs -r sed -i 's|%{buildroot}||g'
sed -i 's|%{buildroot}||g' %{buildroot}%{pegasus_venv}/pyvenv.cfg

# Strip the C executables (they live in the venv's bin/).
for bin in pegasus-kickstart pegasus-cluster pegasus-keg; do
    test -f %{buildroot}%{pegasus_venv}/bin/$bin && strip %{buildroot}%{pegasus_venv}/bin/$bin || true
done

# Put the CLI + C binaries on PATH via symlinks into %{_bindir}.
mkdir -p %{buildroot}%{_bindir}
for f in %{buildroot}%{pegasus_venv}/bin/pegasus*; do
    ln -s %{pegasus_venv}/bin/"$(basename "$f")" %{buildroot}%{_bindir}/"$(basename "$f")"
done

# Make `import Pegasus` work from the system python%{pegasus_python} WITHOUT
# exposing the bundled runtime deps. A .pth adds a curated directory that
# symlinks only the Pegasus package and its single API-surface dependency
# (PyYAML); the heavy deps stay private to the venv.
venv_site=$(%{buildroot}%{pegasus_venv}/bin/python -c "import sysconfig; print(sysconfig.get_path('purelib'))")
venv_site=${venv_site#%{buildroot}}
mkdir -p %{buildroot}%{pegasus_home}/site
for item in Pegasus pegasus_wms-*.dist-info yaml _yaml _yaml*.so PyYAML-*.dist-info pyyaml-*.dist-info; do
    for src in %{buildroot}${venv_site}/$item; do
        [ -e "$src" ] || continue
        ln -s ${venv_site}/"$(basename "$src")" %{buildroot}%{pegasus_home}/site/
    done
done
install -d %{buildroot}%{python_sitearch}
echo '%{pegasus_home}/site' > %{buildroot}%{python_sitearch}/pegasus.pth

# Install systemd service unit from source tree
install -d %{buildroot}%{_unitdir}
install -m 0644 share/pegasus/systemd-unit/pegasus-service.service \
    %{buildroot}%{_unitdir}/

# Remove pyc files and caches
find %{buildroot} -name "*.pyc" -delete
find %{buildroot} -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

%files
%defattr(-,root,root,-)
%{_bindir}/pegasus*
%{pegasus_home}/
%{python_sitearch}/pegasus.pth
%{_unitdir}/pegasus-service.service

%post
systemctl daemon-reload >/dev/null 2>&1 || true

%preun
systemctl stop pegasus-service.service >/dev/null 2>&1 || true
systemctl disable pegasus-service.service >/dev/null 2>&1 || true
systemctl daemon-reload >/dev/null 2>&1 || true

%changelog
* @DATE@ Pegasus Development Team <pegasus-support@isi.edu> @PEGASUS_VERSION@
- @PEGASUS_VERSION@ automatic build

* Mon Dec 02 2013 Pegasus Development Team <pegasus-support@isi.edu> 4.3.2cvs
- Relaxed the "java" requirements in order for the package to work on plan
  CentOS machines
