    "exit_code_unknown",
    "job_removed"
  ],
  "diagnostics_origins": {
    "analysis": "Computed by this run; category and suggestions are present.",
    "event_log": "Read from a replayed or remote JSONL stream, which never stored category or suggestions; both are null."
  },
  "stall_method": "snapshot_timestamps",
  "stall_kinds": [
    "all_held",
    "no_semantic_progress",
    "running_plateau",
    "idle_too_long",
    "no_scheduler_activity"
  ],
  "stall_kinds_live_only": [
    "running_plateau"
  ],
  "stall_kinds_one_shot_only": [
    "no_scheduler_activity"
  ],
  "stall_rules": [
    "Lifecycles are those of observed_job_counts. 'In flight' means pre, queued, running, held or post; 'unfinished' means not succeeded and not failed.",
    "no_scheduler_activity: jobs are unfinished and either a queried queue shows neither DAGMan nor any job of the workflow, or no job is in flight; and seconds_since_progress >= no_progress_seconds. stall.scheduler.dagman_in_queue is false when a queried queue shows no DAGMan job.",
    "all_held: at least one job is in flight and every job in flight is held. Unsubmitted jobs do not prevent it. No time threshold.",
    "jobs_running (not stalled): a job is running. One sample cannot tell a long job from a stuck one, so running_plateau is never reported here.",
    "idle_too_long, no_semantic_progress: jobs are queued and none is running, for idle_threshold_seconds or no_progress_seconds, as in the live detector."
  ],
  "stall_reasons": {
    "stalled": [
      "all_held",
      "no_semantic_progress",
      "idle_too_long",
      "no_scheduler_activity"
    ],
    "not_stalled": [
      "workflow_complete",
      "no_jobs_submitted",
      "startup_grace",
      "within_thresholds",
      "jobs_running"
    ],
    "not_assessed": [
