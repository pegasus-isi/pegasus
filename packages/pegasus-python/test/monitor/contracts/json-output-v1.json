    "analysis_failed",
    "scheduler_evidence_not_recorded"
  ],
  "exit_codes": {
    "0": "A document with error null.",
    "1": "A document whose error names a runtime failure.",
    "2": "A document whose error.code is usage_error; argparse also prints usage to stderr."
  },
