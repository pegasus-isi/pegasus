  "job_counts_sources": {
    "job_counts": "stampede: the lifecycle Stampede records for each job. It trails HTCondor by the delay with which pegasus-monitord records state and keeps the last recorded state of a job that was removed.",
    "observed_job_counts": "job_counts after applying a healthy condor_queue or condor_history result, when sources[] shows one was queried: an unfinished job takes the lifecycle the queue shows, and a job HTCondor removed, or that was unfinished when its workflow ended, is counted as removed. Without a queried queue only the workflow-end rule applies."
  },
  "finding_categories": [
    "held",
    "failed"
  ],
  "finding_severities": [
    "info",
    "warning",
    "error"
  ],
  "hold_codes": [
    "user_hold",
    "output_missing",
    "output_transfer_failed",
