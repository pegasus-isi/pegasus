#!/usr/bin/make -f
# -*- makefile -*-

export DH_VERBOSE=1

PYTHON3 := python3


# Build .deb with gzip compression (compatible with older apt)
# https://stackoverflow.com/questions/71196872/how-do-i-build-a-deb-without-zstd-compression-in-ubuntu-21-10
override_dh_builddeb:
	dh_builddeb -- -Zgzip

override_dh_auto_configure:
	LATEST_GO=$(curl -sSL "https://go.dev/VERSION?m=text" | head -n 1)
	ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')
	wget "https://dl.google.com/go/${LATEST_GO}.linux-${ARCH}.tar.gz"
	tar -C /usr/local -xzf "${LATEST_GO}.linux-${ARCH}.tar.gz"
	rm "${LATEST_GO}.linux-${ARCH}.tar.gz"
	PATH=/usr/local/go/bin:$PATH
	dh_auto_configure

override_dh_auto_configure:
	@set -eu; \
	. /etc/os-release; \
        if ! command -v go >/dev/null 2>&1; then \
		echo "Debian $${VERSION_ID} detected: installing Go from go.dev"; \
		LATEST_GO="$$(curl -fsSL 'https://go.dev/VERSION?m=text' | head -n 1)"; \
		ARCH="$$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')"; \
		wget -q "https://go.dev/dl/$${LATEST_GO}.linux-$${ARCH}.tar.gz"; \
		rm -rf /usr/local/go; \
		tar -C /usr/local -xzf "$${LATEST_GO}.linux-$${ARCH}.tar.gz"; \
		rm -f "$${LATEST_GO}.linux-$${ARCH}.tar.gz"; \
		export PATH="/usr/local/go/bin:$${PATH}"; \
		echo "Using $$(go version)"; \
	fi; \
	dh_auto_configure

build: build-stamp


build-stamp:
	dh_testdir

	# Install build tooling into a temporary virtualenv (not available as distro packages)
	$(PYTHON3) -m venv _build_venv
	_build_venv/bin/pip install --upgrade pip scikit-build-core build
	PYTHON=_build_venv/bin/python make build-worker dist-wheel

	touch build-stamp


install: build
	dh_testdir
	dh_testroot
	dh_prep
	dh_installdirs

	# Build a self-contained venv holding Pegasus + all runtime dependencies, the
	# CLI entry-point scripts, the C binaries and the JARs. Nothing is installed
	# into the system dist-packages, so the bundled deps (Flask, sqlalchemy,
	# boto3, globus-sdk, ...) cannot conflict with or shadow distro packages.
	$(PYTHON3) -m venv debian/pegasus/usr/lib/pegasus/venv
	debian/pegasus/usr/lib/pegasus/venv/bin/pip install --upgrade pip

	debian/pegasus/usr/lib/pegasus/venv/bin/pip install dist/pegasus_wms-*.whl

	# The venv was created under debian/pegasus; strip that build-time prefix from
	# the generated script shebangs and pyvenv.cfg so paths are correct once
	# installed. (bin/python is a symlink to the system interpreter, already ok.)
	grep -rlI '$(CURDIR)/debian/pegasus' debian/pegasus/usr/lib/pegasus/venv/bin \
	    | xargs -r sed -i 's|$(CURDIR)/debian/pegasus||g'
	sed -i 's|$(CURDIR)/debian/pegasus||g' debian/pegasus/usr/lib/pegasus/venv/pyvenv.cfg

	# Strip C executables (they live in the venv's bin/)
	-strip debian/pegasus/usr/lib/pegasus/venv/bin/pegasus-kickstart
	-strip debian/pegasus/usr/lib/pegasus/venv/bin/pegasus-cluster
	-strip debian/pegasus/usr/lib/pegasus/venv/bin/pegasus-keg

	# Put the CLI + C binaries on PATH via symlinks into /usr/bin
	mkdir -p debian/pegasus/usr/bin
	for f in debian/pegasus/usr/lib/pegasus/venv/bin/pegasus*; do \
	    ln -s /usr/lib/pegasus/venv/bin/$$(basename $$f) \
	        debian/pegasus/usr/bin/$$(basename $$f); \
	done

	# Make `import Pegasus` work from the system python3 WITHOUT exposing the
	# bundled runtime deps. A .pth adds a curated dir that symlinks only the
	# Pegasus package and its single API-surface dep (PyYAML); the heavy deps
	# stay private to the venv.
	mkdir -p debian/pegasus/usr/lib/pegasus/site debian/pegasus/usr/lib/python3/dist-packages
	venv_site=$$(debian/pegasus/usr/lib/pegasus/venv/bin/python -c "import sysconfig; print(sysconfig.get_path('purelib'))"); \
	venv_site=$${venv_site#$(CURDIR)/debian/pegasus}; \
	for item in Pegasus pegasus_wms-*.dist-info yaml _yaml _yaml*.so PyYAML-*.dist-info pyyaml-*.dist-info; do \
	    for src in debian/pegasus$$venv_site/$$item; do \
	        [ -e "$$src" ] || continue; \
	        ln -s $$venv_site/$$(basename $$src) debian/pegasus/usr/lib/pegasus/site/; \
	    done; \
	done
	echo /usr/lib/pegasus/site > debian/pegasus/usr/lib/python3/dist-packages/pegasus.pth

	# /etc/pegasus is a real directory for site configuration that the package
	# never overwrites: it ships only the directory and the two links below, so
	# anything an admin puts there survives upgrades (including a change of the
	# venv's Python version) and removal. readlink -f resolves the venv's
	# lib64 -> lib symlink.
	#   /etc/pegasus/samples -> the venv's Pegasus/data/etc (basic.properties,
	#       the sample catalogs, yaml/), which 5.x shipped in /etc/pegasus itself
	#   <venv>/.../Pegasus/data/etc/pegasus.properties -> /etc/pegasus/pegasus.properties
	#       the planner loads pegasus.properties from Pegasus/data/etc (the
	#       pegasus.home.sysconfdir that pegasus-plan passes it), so this makes it
	#       read the admin's file; it skips the link while the target is missing.
	#       pegasus-config --conf follows this link to report /etc/pegasus.
	# The 5.x conffiles in /etc/pegasus are removed on upgrade by
	# debian/pegasus.maintscript.
	set -e; \
	venv_site=$$(debian/pegasus/usr/lib/pegasus/venv/bin/python -c "import sysconfig; print(sysconfig.get_path('purelib'))"); \
	etc_dir=$$(readlink -f $$venv_site/Pegasus/data/etc); \
	test -d "$$etc_dir"; \
	test ! -e "$$etc_dir/pegasus.properties"; \
	install -d debian/pegasus/etc/pegasus; \
	ln -s $${etc_dir#$(CURDIR)/debian/pegasus} debian/pegasus/etc/pegasus/samples; \
	ln -s /etc/pegasus/pegasus.properties $$etc_dir/pegasus.properties

	# Install systemd service unit from source tree
	install -d debian/pegasus/lib/systemd/system
	install -m 0644 share/pegasus/systemd-unit/pegasus-service.service \
	    debian/pegasus/lib/systemd/system/

	# Remove pyc files and __pycache__
	find debian/pegasus/ -name \*.pyc -delete
	find debian/pegasus/ -depth -name __pycache__ -exec rm -rf {} \; 2>/dev/null || true


# Build architecture-independent files here.
binary-indep: build install
	# We have nothing to do by default.

# Build architecture-dependent files here.
binary-arch: build install
	dh_testdir
	dh_testroot
	dh_installchangelogs
	dh_installdocs
	dh_installman
	dh_compress
	dh_fixperms
	dh_installdeb
	# -X is a plain substring match on the file path (no globs). Skip scipy's
	# pip-wheel extension modules and the libraries it vendors in scipy.libs/:
	# those are not owned by any Debian package, so dpkg-shlibdeps cannot
	# resolve them.
	dh_shlibdeps -Xsite-packages/scipy
	dh_gencontrol
	dh_md5sums
	dh_builddeb


binary: binary-indep binary-arch


clean:
	dh_testdir
	dh_testroot
	rm -f build-stamp
	make clean
	rm -rf _build_venv
	dh_clean


%:
	echo "dh $@"
	exit 1


.PHONY: build binary-indep binary-arch binary install clean
