# Wrapper for a CLI tool bundled in the Pegasus worker package. This template
# is instantiated once per tool at build time (see the build_worker_tarball
# target in CMakeLists.txt), which substitutes %%BASE_NAME%% for the tool
# name and installs the result at <worker package>/bin/<tool name>.

BASE_NAME=%%BASE_NAME%%

worker_root=$(dirname "$0")/..
worker_root=$(cd "$worker_root" && pwd)

# PYTHONPATH is read natively by the interpreter so every tool can find the
# bundled Pegasus package and its vendored dependencies (boto3, globus-sdk,
# ...), regardless of whether the tool also parses PEGASUS_PYTHONPATH itself.
if [ "x$PYTHONPATH" != "x" ]; then
    PYTHONPATH="$worker_root:$PYTHONPATH"
else
    PYTHONPATH="$worker_root"
fi
export PYTHONPATH

# Some Pegasus/cli/*.py additionally read PEGASUS_PYTHONPATH themselves.
if [ "x$PEGASUS_PYTHONPATH" != "x" ]; then
    PEGASUS_PYTHONPATH="$worker_root:$PEGASUS_PYTHONPATH"
else
    PEGASUS_PYTHONPATH="$worker_root"
fi
export PEGASUS_PYTHONPATH

exec python3 "$worker_root/Pegasus/cli/$BASE_NAME.py" "$@"
